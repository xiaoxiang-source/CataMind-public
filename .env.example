# Loaded by your service manager/shell; the application does not auto-load .env.
# Generate your own secret; never commit populated copies.
CATMAT_AUTH_ENABLED=1
CATMAT_LOCAL_AUTH_ENABLED=1
CATMAT_JWT_SECRET=

# Optional external software (absolute paths on YOUR machine):
# CATMAT_AII_PY=/opt/conda/envs/aiida/bin/python
# CATMAT_VERDI=/opt/conda/envs/aiida/bin/verdi
# CATMAT_ML_PY=/opt/conda/envs/ml/bin/python
# CATMAT_AIIDA_FILES=/srv/aiida_files
# CATMAT_CP2K_ROOT=/opt/cp2k
# CATMAT_MULTIWFN_BIN=/opt/Multiwfn/Multiwfn
# CATMAT_BADER_BIN=/opt/bader/bader
# CATMAT_POSTPROCESS_ROOTS=/srv/calculations:/srv/research

# Optional writable state locations (create parent directories first):
# CATMAT_DB_PATH=/srv/catamind/catmat.db
# CATMAT_DATA_DIR=/srv/catamind/data
# CATMAT_DATASETS_DIR=/srv/catamind/data/datasets
# CATMAT_CP2K_RUN_DIR=/srv/catamind/cp2k_runs
# CATMAT_LOG_DIR=/srv/catamind/logs
# CATMAT_BACKUP_DIR=/srv/catamind/backups
# CATMAT_TMP_DIR=/srv/catamind/tmp
